{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TexasSolverGui (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/TexasSolverGui.exe",
            "args": [],
            "stopAtEntry": false,
            // The Qt and MinGW runtime DLLs are deployed here by the build.
            "cwd": "${workspaceFolder}/build-debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/Tools/mingw1120_64/bin/gdb.exe",
            "preLaunchTask": "cmake: build debug",
            "setupCommands": [
                {
                    "description": "Readable STL containers",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to running TexasSolverGui (gdb)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build-debug/TexasSolverGui.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/Tools/mingw1120_64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Readable STL containers",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
